{
  "description": "JavaScript 运算符过滤配置",
  "ignore_patterns": [
    "算术运算符（高熵，无法提取有效约束）",
    "bitwise_*",
    "logical_*",
    "comparison operators",
    "assignment operators"
  ],
  "ignore_list": [
    "addition",
    "addition_assignment",
    "subtraction",
    "subtraction_assignment",
    "multiplication",
    "multiplication_assignment",
    "division",
    "division_assignment",
    "remainder",
    "remainder_assignment",
    "exponentiation",
    "exponentiation_assignment",
    "bitwise_and",
    "bitwise_and_assignment",
    "bitwise_or",
    "bitwise_or_assignment",
    "bitwise_xor",
    "bitwise_xor_assignment",
    "bitwise_not",
    "left_shift",
    "left_shift_assignment",
    "right_shift",
    "right_shift_assignment",
    "unsigned_right_shift",
    "unsigned_right_shift_assignment",
    "logical_and",
    "logical_and_assignment",
    "logical_or",
    "logical_or_assignment",
    "logical_not",
    "greater_than",
    "greater_than_or_equal",
    "less_than",
    "less_than_or_equal",
    "equality",
    "inequality",
    "strict_equality",
    "strict_inequality",
    "conditional_operator",
    "nullish_coalescing",
    "nullish_coalescing_assignment",
    "increment",
    "decrement",
    "unary_plus",
    "unary_negation",
    "assignment",
    "operator_precedence"
  ],
  "keep_list": [
    "object_initializer",
    "array_initializer",
    "property_accessors",
    "grouping",
    "spread_syntax",
    "destructuring",
    "new",
    "new.target",
    "this",
    "typeof",
    "yield",
    "yield_star_",
    "await",
    "delete",
    "void",
    "instanceof",
    "in",
    "super",
    "import",
    "import.meta",
    "class",
    "function",
    "function_star_",
    "async_function",
    "async_function_star_",
    "optional_chaining",
    "comma_operator"
  ],
  "reason": {
    "ignore": "二元算术/逻辑运算符后可以跟任何表达式，无法提取强制的特定 token 约束",
    "keep": "结构性运算符有明确的语法结构和强制的 token 序列"
  }
}
