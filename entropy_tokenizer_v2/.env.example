# Hugging Face
HF_TOKEN=

# Paths
ET_DATA_DIR=./data
ET_RESULTS_DIR=./results
ET_CACHE_DIR=./cache
ET_LOCAL_SAMPLE_FILE=./data/starcoder_1m_tokens.txt
ET_HF_DISK_DATASET_FALLBACK=./data/test
ET_SIMPY_DIR=./third_party/Simpy-master

# Eval dataset
ET_EVAL_DATASET=zhensuuu/starcoderdata_100star_py
ET_EVAL_NUM_SAMPLES=1000

# Stage3 Plan A (optional; see docs/stage3_plan_a_integration.md)
# ET_STAGE3_PLAN_A_PROFILE=default
# ET_STAGE3_PLAN_A_POST_PRUNE=1

# Stage3 Hybrid AB (optional; see docs/stage3_hybrid_ab.md)
# ET_STAGE3_BACKEND=hybrid_ab
# ET_STAGE3_AB_MODE=exact_only
# ET_STAGE3_AB_ENABLE_B=1
# ET_STAGE3_AB_FREE_TEXT_MIN_CHARS=24
# ET_STAGE3_AB_FREE_TEXT_MIN_WORDS=4
# ET_STAGE3_AB_B_SIMILARITY_THRESHOLD=0.82
# ET_STAGE3_AB_B_RISK_THRESHOLD=0.72
# ET_STAGE3_AB_B_MIN_CLUSTER_SIZE=2
# ET_STAGE3_AB_A_MIN_OCC=2
# ET_STAGE3_AB_A_MIN_NET_GAIN=1
# ET_STAGE3_AB_A_ALIAS_STYLE=short
# ET_STAGE3_AB_KEY_LIKE_PATTERNS=(?:^|[_\-.])(key|id|name|type|path|url|config|option|field)(?:$|[_\-.])

# HumanEval / model backends
# ET_HUMANEVAL_DATASET=openai/openai_humaneval
# ET_HUMANEVAL_SPLIT=test
# ET_HUMANEVAL_RESULTS_DIR=./results/humaneval
# ET_HUMANEVAL_SUPPORT_DATASET=zhensuuu/starcoderdata_100star_py
# ET_HUMANEVAL_SUPPORT_DATASET_SPLIT=train
# ET_HUMANEVAL_SUPPORT_TEXT_FIELD=content
# ET_HUMANEVAL_SUPPORT_LIMIT=1200
# ET_HUMANEVAL_SUPPORT_TOP_K=4
# ET_HUMANEVAL_SNIPPET_MAX_CHARS=1200
# ET_HUMANEVAL_COMPRESSION_TOKENIZER=gpt4
# For DeepSeek-family evaluation, prefer:
# ET_HUMANEVAL_COMPRESSION_TOKENIZER=deepseek-v31
# ET_HUMANEVAL_STAGE2_PROFILE=
# ET_HUMANEVAL_STAGE2_MODE=

# OpenAI API backend
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ChatAnywhere example:
# OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# vLLM backend
# ET_VLLM_TOKENIZER=
# ET_VLLM_TP_SIZE=1
# ET_VLLM_GPU_MEMORY_UTILIZATION=0.9
# ET_VLLM_DTYPE=auto

